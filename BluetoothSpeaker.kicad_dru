(version 1)
(rule "JLC via hole to other-net track 0.20" (condition "(A.Type == 'Via' && B.Type == 'Track') || (A.Type == 'Track' && B.Type == 'Via')") (constraint hole_clearance (min 0.2mm)))
(rule "JLC component hole to other-net track 0.28" (condition "(A.Type == 'Pad' && A.isPlated() && B.Type == 'Track') || (B.Type == 'Pad' && B.isPlated() && A.Type == 'Track')") (constraint hole_clearance (min 0.28mm)))
(rule "JLC pad drill to pad drill" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
